ARG FEDORA_VERSION=45
ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

FROM ${BASE_IMAGE}

ARG MITHRIL_VERSION=0.0.0-devel
ARG MITHRIL_DISTRO_VERSION=0.0
ARG MITHRIL_BUILD_ID=local

RUN dnf5 install -y \
    anaconda \
    anaconda-install-img-deps \
    anaconda-dracut \
    dracut-config-generic \
    dracut-network \
    net-tools \
    squashfs-tools \
    xorrisofs \
    grub2-efi-x64-cdboot \
    plymouth \
    default-fonts-core-sans \
    default-fonts-other-sans \
    google-noto-sans-cjk-fonts \
    python3-mako \
    lorax-templates-* \
    biosdevname \
    prefixdevname \
    && dnf5 clean all

RUN mkdir -p /boot/efi \
    && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

RUN printf '%s\n' \
        'NAME="Mithril Installer"' \
        "VERSION=\"${MITHRIL_VERSION}\"" \
        'ID=mithril-installer' \
        'ID_LIKE=fedora' \
        "VERSION_ID=\"${MITHRIL_DISTRO_VERSION}\"" \
        "BUILD_ID=\"${MITHRIL_BUILD_ID}\"" \
        "PRETTY_NAME=\"Mithril ${SPACEOS_VERSION} Installer\"" \
        'HOME_URL="https://github.com/CatSlobber/mithril2"' \
        'BUG_REPORT_URL="https://github.com/CatSlobber/mithril/issues"' \
        >/usr/lib/os-release \
    && ln -sfn ../usr/lib/os-release /etc/os-release

RUN mkdir -p /var/mnt
